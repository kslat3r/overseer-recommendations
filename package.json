{
  "name": "overseer-recommendations",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Swipe-style recommendations for Overseerr and Jellyseerr, as a static browser-only SPA.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
